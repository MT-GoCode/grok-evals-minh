+    // When the layout info changes for any reason (e.g. dataset re-order
+    // with stable keys), update the currentPage to the new visible page
+    // index if we are not currently scrolling.
+    LaunchedEffect(state) {
+        snapshotFlow { state.currentLayoutPageInfo?.index }
+            .collect { index ->
+                if (index != null && !state.isScrollInProgress) {
+                    state.onScrollFinished()
+                }
+            }
+    }
