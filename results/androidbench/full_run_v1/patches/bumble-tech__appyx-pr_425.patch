     override fun onCreate() {
         super.onCreate()
+        // Wrap the integration point so that "up" navigation events from the Appyx child
+        // are first attempted to be handled by the RIBs navigation stack (via handleBackPress
+        // which can pop the current RIB from its backstack). Falls back to original behavior.
+        val originalIntegrationPoint = appyxNode.integrationPoint
+        appyxNode.integrationPoint = object : IntegrationPoint(null) {
+            override val activityStarter get() = originalIntegrationPoint.activityStarter
+            override val permissionRequester get() = originalIntegrationPoint.permissionRequester
+            override val isChangingConfigurations get() = originalIntegrationPoint.isChangingConfigurations
+
+            override fun handleUpNavigation() {
+                if (!handleBackPress()) {
+                    originalIntegrationPoint.handleUpNavigation()
+                }
+            }
+
+            override fun onRootFinished() {
+                originalIntegrationPoint.onRootFinished()
+            }
+        }
+
         appyxNode.updateLifecycleState(lifecycle.currentState)
         lifecycle.addObserver(observer)
     }
