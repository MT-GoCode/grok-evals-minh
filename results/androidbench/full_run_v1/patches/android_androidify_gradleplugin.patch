diff --git a/gradle/build-logic/convention/src/main/kotlin/com/google/samples/apps/androidify/buildlogic/AndroidApplicationConventionPlugin.kt b/gradle/build-logic/convention/src/main/kotlin/com/google/samples/apps/androidify/buildlogic/AndroidApplicationConventionPlugin.kt
