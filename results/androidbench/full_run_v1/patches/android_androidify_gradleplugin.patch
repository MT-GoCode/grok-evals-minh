--- /dev/null
+++ b/gradle/build-logic/convention/build.gradle.kts
@@ -0,0 +1,31 @@
+import org.gradle.api.Plugin
+import org.gradle.api.Project
+import org.gradle.kotlin.dsl.apply
+
+plugins {
+    `kotlin-dsl`
+    `java-gradle-plugin`
+}
+
+gradlePlugin {
+    plugins {
+        register("androidApplication") {
+            id = "androidify.androidApplication"
+            implementationClass = "com.google.samples.apps.androidify.buildlogic.AndroidApplicationConventionPlugin"
+        }
+        register("androidLibrary") {
+            id = "androidify.androidLibrary"
+            implementationClass = "com.google.samples.apps.androidify.buildlogic.AndroidLibraryConventionPlugin"
+        }
+        register("androidComposeLibrary") {
+            id = "androidify.androidComposeLibrary"
+            implementationClass = "com.google.samples.apps.androidify.buildlogic.AndroidComposeLibraryConventionPlugin"
+        }
+    }
+}
+
+dependencies {
+    implementation("com.android.tools.build:gradle:8.13.1")
+    implementation("org.jetbrains.kotlin:kotlin-gradle-plugin:2.2.21")
+    implementation("org.jetbrains.kotlin:kotlin-gradle-plugin-api:2.2.21")
+}
